# ==============================================================================
# Environment Variables Template
# ------------------------------------------------------------------------------
# Rename this file to .env or .env.local and populate with your own values.
# DO NOT commit real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
# NODE_ENV determines the environment the app is running in (development, production)
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database Connection
# ------------------------------------------------------------------------------
# Connection string for your primary database.
DATABASE_URL="postgresql://user:password@localhost:5432/db_name?schema=public"

# ------------------------------------------------------------------------------
# Authentication (Clerk)
# ------------------------------------------------------------------------------
# Clerk keys used for user authentication and management.
# Obtain these from your Clerk dashboard (https://dashboard.clerk.com/)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk routing URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ------------------------------------------------------------------------------
# AI API Keys (Gemini)
# ------------------------------------------------------------------------------
# Key for the Gemini API used for AI features.
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# Email & Communications (Resend)
# ------------------------------------------------------------------------------
# API key for Resend email delivery service.
# Obtain from Resend dashboard (https://resend.com/)
RESEND_API_KEY=re_...

# ------------------------------------------------------------------------------
# Security & Protection (Arcjet)
# ------------------------------------------------------------------------------
# API key for Arcjet used for bot protection and rate limiting.
# Obtain from Arcjet dashboard (https://app.arcjet.com/)
ARCJET_KEY=ajkey_...
