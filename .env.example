# ==============================================================================
# Environment Variables Template
# ==============================================================================
# This file serves as a template for the required environment variables.
# Copy this file to '.env' (or '.env.local') and replace the placeholder 
# values with your actual credentials.
#
# IMPORTANT: NEVER commit your actual .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application URL & Environment
# ------------------------------------------------------------------------------
# NODE_ENV: The environment the app is running in (e.g., development, production)
NODE_ENV="development"
# NEXT_PUBLIC_APP_URL: The base URL of your application (used for absolute URLs)
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Database Connection
# ------------------------------------------------------------------------------
# DATABASE_URL: Connection string for your database.
# Format depends on your provider (e.g., PostgreSQL, MySQL, Prisma/Neon/Supabase)
# Obtain from your database provider's dashboard.
DATABASE_URL="postgresql://user:password@host:port/database"

# ------------------------------------------------------------------------------
# Authentication (Clerk)
# ------------------------------------------------------------------------------
# Obtain these from your Clerk dashboard (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Clerk default routing URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ------------------------------------------------------------------------------
# AI API Keys
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini API key for AI features.
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="AIzaSy..."

# ------------------------------------------------------------------------------
# Email Service (Resend)
# ------------------------------------------------------------------------------
# RESEND_API_KEY: API key for sending transactional emails.
# Obtain from Resend dashboard (https://resend.com)
RESEND_API_KEY="re_..."

# ------------------------------------------------------------------------------
# Security & Rate Limiting (Arcjet)
# ------------------------------------------------------------------------------
# ARCJET_KEY: API key for bot protection and rate limiting.
# Obtain from Arcjet dashboard (https://arcjet.com)
ARCJET_KEY="ajkey_..."

# ------------------------------------------------------------------------------
# Background Jobs
# ------------------------------------------------------------------------------
# Keys for background job processing (e.g., Inngest, Upstash, or Trigger.dev)
# Obtain from your respective service provider.
# INNGEST_EVENT_KEY="local"
# INNGEST_SIGNING_KEY="sign_..."
# UPSTASH_REDIS_REST_URL="https://..."
# UPSTASH_REDIS_REST_TOKEN="..."
